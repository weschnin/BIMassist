<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>BIMassist.Mcp.RevitBridge</AssemblyName>
    <RootNamespace>BIMassist.Mcp.RevitBridge</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">$(ProgramW6432)\Autodesk\Revit 2026</RevitInstallDir>
    <DeployToRevit Condition="'$(DeployToRevit)' == ''">false</DeployToRevit>
    <RevitAddinsRoot Condition="'$(RevitAddinsRoot)' == ''">$(APPDATA)\Autodesk\Revit\Addins\2026</RevitAddinsRoot>
    <BridgeDeployDir>$(RevitAddinsRoot)\BIMassist.Mcp</BridgeDeployDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BIMassist.Mcp.Contracts\BIMassist.Mcp.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="BIMassist.Mcp.RevitBridge.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="DeployBridgeToRevit" AfterTargets="Build" Condition="'$(DeployToRevit)' == 'true'">
    <ItemGroup>
      <BridgeDeployFiles Include="$(TargetPath)" />
      <BridgeDeployFiles Include="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
    <MakeDir Directories="$(BridgeDeployDir)" />
    <Copy SourceFiles="@(BridgeDeployFiles)" DestinationFolder="$(BridgeDeployDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\BIMassist.Mcp.RevitBridge.addin" DestinationFolder="$(RevitAddinsRoot)" SkipUnchangedFiles="true" />
  </Target>
</Project>
