{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimassist.local/schemas/plan-set-string-parameters-batch.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["documentKey", "items"],
  "properties": {
    "documentKey": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" },
    "items": { "type": "array", "minItems": 2, "maxItems": 20, "uniqueItems": true, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false, "required": ["target", "parameter", "newString"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "parameter": { "$ref": "#/$defs/parameter" },
        "newString": { "type": "string", "maxLength": 32768 }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "enum": ["document", "element", "elementType"] },
        "uniqueId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
        "elementId": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "document" } }, "required": ["kind"] }, "then": { "not": { "anyOf": [{ "required": ["uniqueId"] }, { "required": ["elementId"] }] } } },
        { "if": { "properties": { "kind": { "enum": ["element", "elementType"] } }, "required": ["kind"] }, "then": { "required": ["uniqueId", "elementId"] } }
      ]
    },
    "parameter": {
      "type": "object", "additionalProperties": false, "required": ["kind", "stableId", "name"],
      "properties": {
        "kind": { "enum": ["sharedGuid", "builtIn", "parameterElement"] },
        "sharedGuid": { "type": "string", "format": "uuid", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
        "builtInId": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807, "not": { "const": 0 } },
        "definitionId": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "stableId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
        "name": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" },
        "ownerContext": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
        "dataTypeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
        "isInstance": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "sharedGuid" } }, "required": ["kind"] }, "then": { "required": ["sharedGuid"], "not": { "anyOf": [{ "required": ["builtInId"] }, { "required": ["definitionId"] }] } } },
        { "if": { "properties": { "kind": { "const": "builtIn" } }, "required": ["kind"] }, "then": { "required": ["builtInId"], "not": { "anyOf": [{ "required": ["sharedGuid"] }, { "required": ["definitionId"] }] } } },
        { "if": { "properties": { "kind": { "const": "parameterElement" } }, "required": ["kind"] }, "then": { "required": ["definitionId", "ownerContext", "dataTypeId"], "not": { "anyOf": [{ "required": ["sharedGuid"] }, { "required": ["builtInId"] }] } } }
      ]
    }
  }
}
