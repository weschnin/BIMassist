{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimassist.local/schemas/bridge-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "schemaVersion", "requestId", "operation", "payload"],
  "properties": {
    "protocolVersion": { "const": "1" },
    "schemaVersion": { "const": "1" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "documentKey": { "type": "string", "minLength": 1, "maxLength": 512 },
    "expectedRevision": { "type": "string", "minLength": 1, "maxLength": 256 },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "operation": {
      "enum": [
        "status.get",
        "document.context.get",
        "family.list",
        "family.metadata.get",
        "element.list",
        "parameter.list",
        "parameter.search",
        "parameter.metadata.get",
        "sharedDefinition.list",
        "projectBinding.list",
        "parameterValue.get",
        "metadataSnapshot.export",
        "parameterValue.set.plan",
        "sharedParameter.family.add.plan",
        "sharedParameter.bind.plan",
        "changePlan.apply"
      ]
    },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "not": { "const": "status.get" } } }, "required": ["operation"] },
      "then": { "required": ["sessionId"] }
    },
    {
      "if": { "properties": { "operation": { "not": { "enum": ["status.get", "document.context.get"] } } }, "required": ["operation"] },
      "then": { "required": ["documentKey"] }
    },
    {
      "if": { "properties": { "operation": { "enum": ["parameterValue.set.plan", "sharedParameter.family.add.plan", "sharedParameter.bind.plan", "changePlan.apply"] } }, "required": ["operation"] },
      "then": { "required": ["expectedRevision", "idempotencyKey"] }
    },
    {
      "if": { "properties": { "operation": { "const": "parameter.search" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/searchDocumentParameters" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "parameterValue.set.plan" } }, "required": ["operation"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/planSetParameterValue" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "changePlan.apply" } }, "required": ["operation"] },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["planId", "planHash", "expectedRevision", "idempotencyKey", "approval"],
            "properties": {
              "planId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "planHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "expectedRevision": { "type": "string", "minLength": 1, "maxLength": 256 },
              "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
              "approval": {
                "type": "object",
                "additionalProperties": false,
                "required": ["approvedBy", "approvedAtUtc", "source"],
                "properties": {
                  "approvedBy": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "approvedAtUtc": { "type": "string", "format": "date-time", "pattern": "^(?!0001-).*(Z|[+]00:00)$" },
                  "source": { "type": "string", "minLength": 1, "maxLength": 128 }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "searchDocumentParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "nameContains", "includeTypes"],
      "properties": {
        "page": {
          "type": "object", "additionalProperties": false, "required": ["pageSize"],
          "properties": {
            "pageSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "cursor": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S" }
          }
        },
        "nameContains": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" },
        "categoryId": {
          "type": "string", "maxLength": 128,
          "pattern": "^revit-category:(?:-?(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)|-9223372036854775808)$"
        },
        "includeTypes": { "type": "boolean" }
      }
    },
    "planSetParameterValue": {
      "type": "object", "additionalProperties": false, "required": ["target", "parameter", "after"],
      "properties": {
        "target": {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {
            "kind": { "enum": ["document", "element", "elementType"] },
            "uniqueId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
            "elementId": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }
          },
          "allOf": [
            { "if": { "properties": { "kind": { "const": "document" } }, "required": ["kind"] }, "then": { "not": { "anyOf": [{ "required": ["uniqueId"] }, { "required": ["elementId"] }] } } },
            { "if": { "properties": { "kind": { "enum": ["element", "elementType"] } }, "required": ["kind"] }, "then": { "anyOf": [{ "required": ["uniqueId"] }, { "required": ["elementId"] }] } }
          ]
        },
        "parameter": {
          "type": "object", "additionalProperties": false, "required": ["kind", "stableId", "name"],
          "properties": {
            "kind": { "enum": ["sharedGuid", "builtIn", "parameterElement"] },
            "sharedGuid": { "type": "string", "format": "uuid", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
            "builtInId": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807, "not": { "const": 0 } },
            "definitionId": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
            "stableId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
            "name": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" },
            "ownerContext": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
            "dataTypeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
            "isInstance": { "type": "boolean" }
          },
          "allOf": [
            { "if": { "properties": { "kind": { "const": "sharedGuid" } }, "required": ["kind"] }, "then": { "required": ["sharedGuid"], "not": { "anyOf": [{ "required": ["builtInId"] }, { "required": ["definitionId"] }] } } },
            { "if": { "properties": { "kind": { "const": "builtIn" } }, "required": ["kind"] }, "then": { "required": ["builtInId"], "not": { "anyOf": [{ "required": ["sharedGuid"] }, { "required": ["definitionId"] }] } } },
            { "if": { "properties": { "kind": { "const": "parameterElement" } }, "required": ["kind"] }, "then": { "required": ["definitionId", "ownerContext", "dataTypeId"], "not": { "anyOf": [{ "required": ["sharedGuid"] }, { "required": ["builtInId"] }] } } }
          ]
        },
        "after": {
          "type": "object", "additionalProperties": false, "required": ["kind", "hasValue", "isReadOnly", "stringValue"],
          "properties": {
            "kind": { "const": "string" },
            "hasValue": { "const": true },
            "isReadOnly": { "const": false },
            "stringValue": { "type": "string", "maxLength": 32768 }
          }
        }
      }
    }
  }
}
