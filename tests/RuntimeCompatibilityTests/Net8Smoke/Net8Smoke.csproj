<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RollForward>LatestPatch</RollForward>
    <UseProductionAssembly Condition="'$(UseProductionAssembly)' == ''">false</UseProductionAssembly>
    <OutputPath>bin/$(Configuration)/$(UseProductionAssembly)/</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseProductionAssembly)' != 'true'">
    <Compile Include="../../../Ava/Core/*.cs" LinkBase="Ava/Core" />
    <Compile Include="../../../Ava/Views/*.cs" LinkBase="Ava/Views" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseProductionAssembly)' == 'true'">
    <!-- Exercise the already-built production artifact, without copying or loading host APIs. -->
    <Reference Include="BIMassist">
      <HintPath>../../../bin/Release/net8.0-windows/BIMassist.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
