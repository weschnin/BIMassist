<Window x:Class="BIMassist.Views.SnapshotPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gespeicherte SectionBoxes" Height="360" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Bitte einen Snapshot auswählen:"/>
        <ListBox x:Name="List" Grid.Row="2" DisplayMemberPath="Display" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Abbrechen" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Wiederherstellen" IsDefault="True" Click="OnRestoreClick"/>
        </StackPanel>
    </Grid>
</Window>