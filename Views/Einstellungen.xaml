<Window x:Class="BIMassist.Einstellungen"
        x:Name="WindowEinstellungen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" Topmost="True" SizeToContent="Height" Icon="/BIMassist;component/Resources/settings_32px.png"
        Title="Einstellungen" Width="500">

    <StackPanel Margin="20,16,20,20">
        <TextBlock Text="Dateipfad für Autospeicherung" Margin="0,0,0,6"/>
        <TextBox x:Name="textBoxExportPfad" Text="{Binding EigeneDaten, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Height="24"/>
        <Button x:Name="button" Command="{Binding OpenOwnDataCommand}" CommandParameter="True" Content="Wählen"
                HorizontalAlignment="Right" Margin="0,6,0,12" Padding="10,3"/>
        <CheckBox x:Name="checkBoxAutoSave" Content="Nach Eintragung der Baugruppenkennzeichnung Familien speichern"
                  IsChecked="{Binding FamilyAutoSave, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Margin="0,0,0,9"/>
        <CheckBox x:Name="checkBoxBestätingBGKZUweisung" Content="Bestätigung bei BGK-Zuweisung"
                  IsChecked="{Binding BestaetigungBGKZUweisung, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Margin="0,0,0,12"/>
        <GroupBox Header="3DText generieren" Margin="0,0,0,14">
            <Grid Margin="10,9,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Texthöhe [mm]" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox Grid.Column="1" Text="{Binding Bgk3DTextHeightMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="Extrusionstiefe [mm]" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Bgk3DTextDepthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </GroupBox>
        <Button x:Name="buttonClose" Content="Übernehmen und Schließen" Command="{Binding CloseSettingsWindow}"
                HorizontalAlignment="Left" Padding="10,4"/>
    </StackPanel>
</Window>
