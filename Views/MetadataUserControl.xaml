<UserControl x:Class="BIMassist.Views.MetadataUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BIMassist.Helpers"
             Width="310"
             Background="White" Height="625">

    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <!-- Einheitlicher Button-Stil -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Einheitliche Eingabefeld-Höhe -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="23"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="23"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="30"/>
            <!-- war 23 -->
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Einheitliche Label-Gestaltung -->
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,1"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,20,20">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Überschrift -->
            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="Metadaten"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#2D2D30"/>
                <Separator Margin="0,2,0,0" Background="#CCC"/>
            </StackPanel>

            <!-- Eingabebereich -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,-12,22" Grid.RowSpan="2">
                <TextBlock Text="Revit-Familienname:" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding FamilyName}" IsReadOnly="True"/>

                <TextBlock Text="Speicherpfad Revit-Familie:" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding FamilyPath}" IsReadOnly="True" Width="250"/>

                <!-- Entwickler Vorname -->
                <!--<TextBlock Text="Entwickler Vorname:" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding DeveloperFirstName}" IsReadOnly="{Binding IsReadOnly}"/>-->

                <TextBlock Text="Entwickler / Name:" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding DeveloperLastName}" IsReadOnly="{Binding IsReadOnly}"/>

                <TextBlock Text="Entwickler / Organisation:" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Owner}" IsReadOnly="{Binding IsReadOnly}" Height="40"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="E-Mail:" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Email}" IsReadOnly="{Binding IsReadOnly}"/>

                <TextBlock Text="Stand der Bearbeitung:" Style="{StaticResource LabelStyle}"/>
                <DatePicker SelectedDate="{Binding EditDate}" 
                            IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"/>

                <TextBlock Text="Beschreibung:" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Description}" AcceptsReturn="True" Height="50"
                         TextWrapping="Wrap" IsReadOnly="{Binding IsReadOnly}" Width="250"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"/>

                <!-- Passwortzeile -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <TextBlock Text="Passwort:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <PasswordBox x:Name="PasswordBox" Margin="0,0,6,0"/>
                    <Button Content="Entsperren" Width="90" Click="Unlock_Click" IsEnabled="{Binding IsReadOnly}"/>
                </StackPanel>

                <!-- Aktionsbuttons -->
                <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                    <!-- Erste Button-Zeile -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Speichern" Click="Save_Click" Width="75" Margin="0,0,4,0"/>
                        <Button Content="Kopieren" Command="{Binding CopyCommand}" Width="75"/>
                    </StackPanel>
                    <!-- Zweite Button-Zeile (Vorlagen) -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Vorlage speichern" Click="SaveTemplate_Click" Width="110" Margin="0,0,4,0"/>
                        <Button Content="Vorlage laden" Click="LoadTemplate_Click" Width="100"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Status -->
            <TextBlock Text="{Binding StatusMessage}" Grid.Row="2"
                       Margin="0,6,0,0" FontWeight="SemiBold"
                       Foreground="#107C10" TextWrapping="Wrap"
                       HorizontalAlignment="Left"/>
        </Grid>
    </ScrollViewer>
</UserControl>