<UserControl x:Class="BIMassist.Views.MetadataUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:BIMassist.Helpers"
    Height="320" Width="300"
    Background="White">

    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>
    <Grid Margin="8" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Eingabefelder -->
            <RowDefinition Height="Auto"/>
            <!-- Passwort+Entsperren -->
            <RowDefinition Height="Auto"/>
            <!-- Aktionen -->
            <RowDefinition Height="Auto"/>
            <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Eingabefelder -->
        <StackPanel Grid.Row="0" Margin="0,0,0,2">
            <TextBlock Text="Familienname:" FontWeight="Bold"/>
            <TextBox Text="{Binding FamilyName}" IsReadOnly="True" Width="225" Margin="0,0,0,2" HorizontalAlignment="Left"/>

            <TextBlock Text="Entwickler Vorname:"/>
            <TextBox Text="{Binding DeveloperFirstName, UpdateSourceTrigger=PropertyChanged}" 
                     IsReadOnly="{Binding IsReadOnly}" Width="225" Margin="0,0,0,2" HorizontalAlignment="Left"/>

            <TextBlock Text="Entwickler Nachname:"/>
            <TextBox Text="{Binding DeveloperLastName, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding IsReadOnly}" Width="225" Margin="0,0,0,2" HorizontalAlignment="Left"/>

            <TextBlock Text="Eigentümer/Organisation:"/>
            <TextBox Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" 
                     IsReadOnly="{Binding IsReadOnly}" Width="225" Margin="0,0,0,2" HorizontalAlignment="Left"/>

            <TextBlock Text="E-Mail:"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                     IsReadOnly="{Binding IsReadOnly}" Width="225" Margin="0,0,0,2" HorizontalAlignment="Left"/>

            <TextBlock Text="Stand der Bearbeitung:"/>
            <DatePicker SelectedDate="{Binding EditDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                        Width="140" HorizontalAlignment="Left" Margin="0,0,0,2"/>

            <TextBlock Text="Beschreibung:"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                     AcceptsReturn="True" Height="40"
                     TextWrapping="Wrap" IsReadOnly="{Binding IsReadOnly}" Width="225" Margin="0,0,0,2" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Passwort + Entsperren -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,2">
            <Label Content="Passwort:" VerticalAlignment="Center"/>
            <PasswordBox x:Name="PasswordBox" Width="110" Margin="2,0,6,0" HorizontalAlignment="Left"/>
            <Button Content="Entsperren" Width="80" Click="Unlock_Click" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- Aktionen: Speichern & Kopieren -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,2">
            <Button Content="Speichern" Command="{Binding SaveCommand}" Width="92" Margin="0,0,10,0"/>
            <Button Content="Daten kopieren" Command="{Binding CopyCommand}" Width="110"/>
        </StackPanel>

        <!-- Statuszeile -->
        <TextBlock Text="{Binding StatusMessage}" 
                   Grid.Row="3"
                   FontWeight="SemiBold"
                   Foreground="DarkGreen"
                   Margin="0,2,0,0"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
