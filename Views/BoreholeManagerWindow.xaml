<Window x:Class="BIMassist.Views.BoreholeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Borehole Manager"
        Width="1200" Height="750"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
            <WrapPanel Margin="8" Orientation="Horizontal">
                <WrapPanel.Resources>
                    <Style TargetType="GroupBox">
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="VerticalAlignment" Value="Top"/>
                    </Style>
                    <Style TargetType="Button">
                        <Setter Property="Margin" Value="3"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="MinHeight" Value="30"/>
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </WrapPanel.Resources>

                <GroupBox Header="Datenimport">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel>
                            <Button Content="Bohrungen importieren" Command="{Binding ImportHolesCmd}"/>
                            <Button Content="Geologie importieren" Command="{Binding ImportGeologyCmd}"/>
                            <Button Content="Paar importieren (CSV mehrfach)" Command="{Binding ImportPairCmd}"/>
                        </WrapPanel>
                        <Button Content="Änderungen speichern" HorizontalAlignment="Left" Margin="3,8,3,3" Command="{Binding SaveChangesCmd}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Modelle">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel>
                            <Button Content="Extrusionen erstellen" Command="{Binding CreateExtrusionsCmd}"/>
                            <Button Content="Umriss eingeben" ToolTip="Umriss für das 3D-Bodenmodell neu anklicken und im Projekt speichern" Command="{Binding SetBoundaryCmd}"/>
                            <Button Content="3D-Bodenmodell erzeugen" Command="{Binding CreateGroundModelCmd}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding BoundaryStatusText}" Margin="6,8,3,0" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#B00020"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSavedBoundary}" Value="True">
                                            <Setter Property="Foreground" Value="#107C10"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding AxisStatusText}" Margin="6,3,3,0" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#B00020"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSavedAxis}" Value="True">
                                            <Setter Property="Foreground" Value="#107C10"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Eingaben">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel>
                            <Button Content="Neue Bohrung" Command="{Binding NewBoreholeCmd}"/>
                            <Button Content="Koordinate wählen" ToolTip="Rechts-/Hochwert durch Klick in der aktuellen Ansicht setzen" Command="{Binding PickCoordinateCmd}"/>
                            <Button Content="Bohrung löschen" Command="{Binding DeleteHoleCmd}"/>
                            <Button Content="Neue Schicht" Command="{Binding NewLayerCmd}"/>
                            <Button Content="Schicht löschen" Command="{Binding DeleteLayerCmd}"/>
                            <Button Content="Alle Daten löschen" Command="{Binding ClearAllCmd}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="Ø [cm]:" Margin="3,0,6,0"/>
                            <TextBox Width="70" Margin="3" Padding="4,2" VerticalContentAlignment="Center" Text="{Binding BoreholeDiameterCm, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"/>
                            <TextBlock Text="Material aus:" Margin="16,0,6,0"/>
                            <ComboBox Width="170" Margin="3" ItemsSource="{Binding MaterialNameColumns}" SelectedItem="{Binding SelectedMaterialNameColumn}"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
            </WrapPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="HolesGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding Boreholes}"
                      SelectedItem="{Binding SelectedBorehole}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      ColumnWidth="SizeToCells"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      RowEditEnding="HolesGrid_RowEditEnding">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="LocationID" Binding="{Binding LocationID, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="120"/>
                    <DataGridTextColumn Header="Typ" Binding="{Binding LocationType, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="120"/>
                    <DataGridTextColumn Header="Easting" Binding="{Binding Easting, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="Auto" MinWidth="120"/>
                    <DataGridTextColumn Header="Northing" Binding="{Binding Northing, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="Auto" MinWidth="120"/>
                    <DataGridTextColumn Header="GOK" Binding="{Binding GroundLevel, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="Auto" MinWidth="110"/>
                    <DataGridTextColumn Header="Endtiefe" Binding="{Binding FinalDepth, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="Auto" MinWidth="110"/>
                    <DataGridTextColumn Header="Orientation" Binding="{Binding Orientation, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="120"/>
                    <DataGridTextColumn Header="Inclination" Binding="{Binding Inclination, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="120"/>
                </DataGrid.Columns>

                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteHoleCmd}"/>
                </DataGrid.InputBindings>

                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Bohrung löschen" Command="{Binding DeleteHoleCmd}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#22000000" ShowsPreview="True" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

            <DataGrid x:Name="LayersGrid"
                      Grid.Row="2"
                      ItemsSource="{Binding LayersForSelection}"
                      SelectedItem="{Binding SelectedLayer}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      ColumnWidth="SizeToCells"
                      HeadersVisibility="Column"
                      SelectionMode="Extended"
                      RowEditEnding="LayersGrid_RowEditEnding">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="LocationID" Binding="{Binding LocationID, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="120"/>
                    <DataGridTextColumn Header="Top [m]" Binding="{Binding DepthTop, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="Auto" MinWidth="90"/>
                    <DataGridTextColumn Header="Base [m]" Binding="{Binding DepthBase, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" Width="Auto" MinWidth="90"/>
                    <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="150"/>
                    <DataGridTextColumn Header="Class" Binding="{Binding Classification, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="120"/>
                    <DataGridTextColumn Header="Code" Binding="{Binding GeologyCode, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="90"/>
                    <DataGridTextColumn Header="Colour" Binding="{Binding Colour, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="90"/>
                    <DataGridTextColumn Header="Consistency" Binding="{Binding Consistency, UpdateSourceTrigger=PropertyChanged}" Width="Auto" MinWidth="120"/>
                </DataGrid.Columns>

                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteLayerCmd}"/>
                </DataGrid.InputBindings>

                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Schicht löschen" Command="{Binding DeleteLayerCmd}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>

            </DataGrid>
        </Grid>
    </Grid>
</Window>

