<UserControl x:Class="BIMassist.Views.BGKManagerUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Height="285" Width="510" Background="White">
    <StackPanel Margin="10">
        <TextBlock Text="Eintragungstext:" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Eintragungstext, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
        <Button Content="Übertragen" Command="{Binding UebertragenCommand}" Width="100" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding Statusanzeige}" Foreground="DarkRed" FontWeight="Bold"/>
    </StackPanel>
</UserControl>
