<UserControl x:Class="BIMassist.Views.BGKManagerUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:BIMassist.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="White">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal">
            <Button Content="Import…"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Command="{Binding ImportCommand}"/>
            <Button Content="Werte übertragen"
                    Padding="12,6"
                    Command="{Binding SendValuesCommand}"/>
        </StackPanel>

        <!-- TreeView: Kategorien (Baugruppe) -> Typen (Typmarkierung) -->
        <TreeView x:Name="BaugruppenTreeView"
                  Grid.Row="1"
                  ItemsSource="{Binding Baugruppen}"
                  SelectedItemChanged="BaugruppenTreeView_SelectedItemChanged">
            <TreeView.Resources>
                <!-- Kategorie-Knoten -->
                <HierarchicalDataTemplate DataType="{x:Type models:Baugruppe}"
                                          ItemsSource="{Binding Typmarkierungen}">
                    <TextBlock Text="{Binding Key}"/>
                </HierarchicalDataTemplate>

                <!-- Typ-Eintrag -->
                <DataTemplate DataType="{x:Type models:Typmarkierung}">
                    <TextBlock>
                        <Run Text="{Binding Typnummer}"/>
                        <Run Text=" — "/>
                        <Run Text="{Binding Beschreibung}"/>
                    </TextBlock>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <!-- Statuszeile -->
        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="Gray"
                   Text="{Binding StatusText}"/>
    </Grid>
</UserControl>
